#!/bin/bash
set -euo pipefail

# ============================================================
# harness — Mick Agent Harness 全局 CLI
#
# 一次全局安装，任何项目中一键初始化。
#
# 安装：
#   git clone https://github.com/MickMi/mick_harness_rules.git ~/.mick-harness
#   ln -s ~/.mick-harness/bin/harness ~/.local/bin/harness
#
# 使用：
#   harness init              # 当前目录初始化（默认只挂 AGENTS.md）
#   harness init --full       # 额外启用 config / Brain 检查
#   harness init --all-rules  # 额外挂旧工具入口
#   harness export api        # 输出纯 API 可注入的 Harness Prompt
#   harness update             # 更新全局 harness + 注册项目
#   harness check              # 验证当前项目完整性
#   harness observe status     # 查看只读运行观察状态
#   harness version            # 查看版本
# ============================================================

HARNESS_GLOBAL="${MICK_HARNESS_ROOT:-$HOME/.mick-harness}"
HARNESS_STATE_DIR="${MICK_HARNESS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/mick-harness}"
HARNESS_REGISTRY="$HARNESS_STATE_DIR/registered-projects"
HARNESS_REPO="https://github.com/MickMi/mick_harness_rules.git"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'
info()  { echo -e "${CYAN}ℹ️  $1${NC}"; }
ok()    { echo -e "${GREEN}✅ $1${NC}"; }
warn()  { echo -e "${YELLOW}⚠️  $1${NC}"; }
fail()  { echo -e "${RED}❌ $1${NC}"; }

harness_available() {
    [ -x "$HARNESS_GLOBAL/generate.sh" ] && [ -f "$HARNESS_GLOBAL/scripts/lib-mount-rules.sh" ]
}

ensure_state_dir() {
    mkdir -p "$HARNESS_STATE_DIR"
}

register_project() {
    local target="$1"
    ensure_state_dir
    if ! grep -qxF "$target" "$HARNESS_REGISTRY" 2>/dev/null; then
        echo "$target" >> "$HARNESS_REGISTRY"
    fi
}

migrate_legacy_registry() {
    local legacy="$HARNESS_GLOBAL/.registered-projects"
    [ -f "$legacy" ] || return 0

    ensure_state_dir
    while IFS= read -r proj; do
        [ -z "$proj" ] && continue
        grep -qxF "$proj" "$HARNESS_REGISTRY" 2>/dev/null || echo "$proj" >> "$HARNESS_REGISTRY"
    done < "$legacy"
}

stash_legacy_registry_if_dirty() {
    local legacy_rel=".registered-projects"
    local legacy="$HARNESS_GLOBAL/$legacy_rel"
    [ -d "$HARNESS_GLOBAL/.git" ] || return 0
    git -C "$HARNESS_GLOBAL" ls-files --error-unmatch "$legacy_rel" >/dev/null 2>&1 || return 0
    [ -f "$legacy" ] || return 0

    if ! git -C "$HARNESS_GLOBAL" diff --quiet -- "$legacy_rel" 2>/dev/null; then
        warn "Migrating legacy project registry out of the harness repo."
        migrate_legacy_registry
        git -C "$HARNESS_GLOBAL" stash push -q -m "mick-harness legacy registry migration" -- "$legacy_rel" 2>/dev/null || true
    else
        migrate_legacy_registry
    fi
}

install_observer_service() {
    [ "${MICK_HARNESS_OBSERVER_AUTO_INSTALL:-1}" != "0" ] || return 0
    [ "$(uname -s)" = "Darwin" ] || return 0
    command -v python3 >/dev/null 2>&1 || { warn "Python 3 unavailable; Observer service was not installed."; return 0; }
    local observer="$HARNESS_GLOBAL/scripts/harness-observe.py"
    [ -f "$observer" ] || { warn "Observer runtime missing; service was not installed."; return 0; }
    if MICK_HARNESS_ACTIVITY=0 python3 "$observer" service install >/dev/null; then
        ok "Mick Harness Observer installed at http://127.0.0.1:6425/."
    else
        warn "Harness installed, but Observer service setup failed. Retry: harness observe service install"
    fi
}

# ============================================================
# harness version
# ============================================================
cmd_version() {
    local declared=""
    [ -f "$HARNESS_GLOBAL/VERSION" ] && declared=$(tr -d '[:space:]' < "$HARNESS_GLOBAL/VERSION")
    if [ -d "$HARNESS_GLOBAL/.git" ]; then
        local revision
        revision=$(git -C "$HARNESS_GLOBAL" describe --tags --always 2>/dev/null || echo "unknown")
        echo "Mick Agent Harness ${declared:-unknown}  ($HARNESS_GLOBAL · git $revision)"
    elif harness_available; then
        echo "Mick Agent Harness ${declared:-local checkout}  ($HARNESS_GLOBAL)"
    else
        echo "Mick Agent Harness (not installed. Run: harness install)"
    fi
}

# ============================================================
# harness install — clone global harness repo once
# ============================================================
cmd_install() {
    if [ -d "$HARNESS_GLOBAL/.git" ]; then
        ok "Harness already installed at $HARNESS_GLOBAL"
        info "Run 'harness update' to pull latest."
        install_observer_service
        return 0
    fi
    if [ -e "$HARNESS_GLOBAL" ]; then
        if harness_available; then
            ok "Harness available at $HARNESS_GLOBAL"
            install_observer_service
            return 0
        fi
        fail "Install target exists but is not a harness repo: $HARNESS_GLOBAL"
        return 1
    fi

    info "Installing Mick Agent Harness to $HARNESS_GLOBAL ..."
    git clone "$HARNESS_REPO" "$HARNESS_GLOBAL" || { fail "git clone failed."; return 1; }
    chmod +x "$HARNESS_GLOBAL"/*.sh "$HARNESS_GLOBAL"/bin/* "$HARNESS_GLOBAL"/scripts/*.sh 2>/dev/null || true

    # Add to PATH hint
    local bin_dir="$HARNESS_GLOBAL/bin"
    if [ -d "$HOME/.local/bin" ] && [ ! -L "$HOME/.local/bin/harness" ]; then
        ln -s "$bin_dir/harness" "$HOME/.local/bin/harness" 2>/dev/null || true
    fi

    echo ""
    ok "Harness installed."
    cmd_agents sync --quiet
    install_observer_service
    echo ""
    echo "  确保 ~/.local/bin 在 PATH 中（大多数 macOS 已默认包含）："
    echo "    export PATH=\"\$HOME/.local/bin:\$PATH\""
    echo ""
    echo "  然后进入任意项目目录："
    echo "    harness init"
}

# ============================================================
# harness init [project-dir] — one-command project bootstrap
# ============================================================
cmd_init() {
    if ! harness_available; then
        info "Harness not yet installed. Installing first..."
        cmd_install || { fail "Install failed."; exit 1; }
        echo ""
    fi

    local target=""
    local rule_mode="single"
    local full_mode=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full)
                full_mode=true
                shift
                ;;
            --all-rules|--compat)
                rule_mode="all"
                shift
                ;;
            -h|--help)
                echo "Usage: harness init [dir] [--full] [--all-rules]"
                echo ""
                echo "Default: mount AGENTS.md + update .gitignore only."
                echo "Use --full for config/Brain checks; --all-rules for legacy tool files."
                return 0
                ;;
            -*)
                fail "Unknown init option: $1"
                exit 1
                ;;
            *)
                if [ -n "$target" ]; then
                    fail "Only one target directory can be provided."
                    exit 1
                fi
                target="$1"
                shift
                ;;
        esac
    done

    target="${target:-$(pwd)}"
    target="$(cd "$target" 2>/dev/null && pwd || echo "")"
    if [ -z "$target" ] || [ ! -d "$target" ]; then
        fail "Target directory does not exist: ${1:-current dir}"
        exit 1
    fi

    echo -e "${BOLD}🚀 harness init${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  Target: $target"
    echo "  Mode  : $rule_mode"
    echo ""

    # 1. Symlink
    local hl="$target/.harness"
    if [ -L "$hl" ]; then
        ok ".harness/ already exists."
    elif [ -d "$hl" ]; then
        if [ -f "$hl/generate.sh" ] && [ -f "$hl/scripts/lib-mount-rules.sh" ]; then
            local backup
            backup="$target/.harness.legacy-$(date +%Y%m%d-%H%M%S)"
            mv "$hl" "$backup"
            ok "Compatible legacy .harness/ moved to $(basename "$backup")."
            ln -s "$HARNESS_GLOBAL" "$hl" && ok ".harness/ → $HARNESS_GLOBAL"
        else
            warn ".harness/ is a real directory but not a recognized Harness checkout. Skipping symlink."
        fi
    else
        ln -s "$HARNESS_GLOBAL" "$hl" && ok ".harness/ → $HARNESS_GLOBAL"
    fi

    # 2. Generate + mount
    local g="$HARNESS_GLOBAL/generate.sh"
    if [ -x "$g" ]; then
        if [ "$rule_mode" = "all" ]; then
            "$g" --all >/dev/null 2>&1 && ok "Rule files generated."
        else
            "$g" >/dev/null 2>&1 && ok "AGENTS.md generated."
        fi
    fi
    if [ -f "$HARNESS_GLOBAL/scripts/lib-mount-rules.sh" ]; then
        source "$HARNESS_GLOBAL/scripts/lib-mount-rules.sh"
        mount_rule_files "$HARNESS_GLOBAL" "$target" "$rule_mode"
    fi

    # 3. .gitignore
    local gi="$target/.gitignore"
    [ ! -f "$gi" ] && touch "$gi"
    for e in ".harness/" ".harness" "${HARNESS_OWNED_FILES[@]:-}"; do
        grep -qxF "$e" "$gi" 2>/dev/null || echo "$e" >> "$gi"
    done
    ok ".gitignore updated."

    if [ "$full_mode" = true ]; then
        # 4. Config
        local cf="$target/.harness-config.yaml"
        if [ ! -f "$cf" ] && [ -f "$HARNESS_GLOBAL/config/.harness-config.template.yaml" ]; then
            cp "$HARNESS_GLOBAL/config/.harness-config.template.yaml" "$cf"
        fi
        ok ".harness-config.yaml ready."

        # 5. Brain + Verify
        if [ -f "$HARNESS_GLOBAL/scripts/brain-resolve.sh" ]; then
            source "$HARNESS_GLOBAL/scripts/brain-resolve.sh"
            ensure_brain_available "$HARNESS_GLOBAL" 2>/dev/null || true
        fi
        [ -x "$HARNESS_GLOBAL/scripts/brain-check.sh" ] && "$HARNESS_GLOBAL/scripts/brain-check.sh" "$target" 2>&1 || true
    fi

    cmd_agents sync --quiet
    register_project "$target"

    echo ""
    echo -e "${GREEN}${BOLD}✅ Done.${NC} 当前项目受 Harness 约束。"
    echo "  验证 Agent: 让它做 Harness Self-Test。"
    echo ""
}

detect_project_rule_mode() {
    local project="$1"
    local f
    for f in "CLAUDE.md" ".cursorrules" ".windsurfrules" ".clinerules" ".github/copilot-instructions.md" ".trae/rules.md"; do
        if [ -L "$project/$f" ]; then
            echo "all"
            return 0
        fi
    done
    echo "single"
}

print_core_rules() {
    local core="$HARNESS_GLOBAL/rules/core.md"
    if [ -f "$core" ]; then
        cat "$core"
    else
        cat <<'EOF'
# Mick Agent Harness Core Rules

Harness core rules are not available in this checkout. Load the project AGENTS.md first. If the file is missing, stop and ask the user to run `harness init`.
EOF
    fi
}

print_extended_rules() {
    local extended="$HARNESS_GLOBAL/rules/extended.md"
    if [ -f "$extended" ]; then
        cat "$extended"
    else
        cat <<'EOF'
# Mick Agent Harness Extended Playbook

Extended rules are not available in this checkout. If the task is high-risk, stop and ask the user to provide `.harness/rules/extended.md`.
EOF
    fi
}

print_extended_policy() {
    local include_extended="$1"
    if [ "$include_extended" = true ]; then
        echo ""
        echo "## Inline Extended Playbook"
        echo ""
        print_extended_rules
    else
        cat <<'EOF'

## Extended Playbook Loading

Default export includes the Core Rules only to keep everyday context affordable. For high-risk work, repeated bugs, multi-role workflow, CI/CD, git operations, UI interaction QA, external systems, or Brain writes, load `.harness/rules/extended.md` from the project. If there is no filesystem access and full inline context is required, generate this loader with `harness export <surface> --full`.
EOF
    fi
}

print_project_manifest_state() {
    local target="$1"
    echo "Project: $target"
    if [ -f "$target/AGENTS.md" ]; then
        echo "Manifest: $target/AGENTS.md"
    elif [ -f "$target/.harness/dist/AGENTS.md" ]; then
        echo "Manifest: $target/.harness/dist/AGENTS.md"
    else
        echo "Manifest: not found. Run \`harness init\` in the project, or inject this exported loader directly."
    fi
}

emit_common_contract() {
    cat <<'EOF'
## Loading Contract

- This Harness is a context contract plus local verification scripts. It does not rely on one vendor-specific magic file.
- If project files are accessible, load the project manifest first: `AGENTS.md`, then `.harness/dist/AGENTS.md`, then `.harness/rules/core.md`.
- If project files are not accessible, use the inline Core Rules below as the active contract and explicitly mark file-dependent checks as unverified.
- `plan.md` is not a conversation hijacker. It is checked only when the current turn will edit files, generate deliverables, execute an existing plan, or resume workflow state.
- Pure explanation, direction discussion, brainstorming, and requirement shaping can proceed conversationally while still respecting the evidence, scope, and verification rules.
- A task is not done until it has a concrete artifact or answer plus reproducible verification evidence, or it is clearly labeled as unverified.
EOF
}

cmd_export() {
    local surface="${1:-agent}"
    [ $# -gt 0 ] && shift
    local include_extended=false
    local target=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full|--extended)
                include_extended=true
                shift
                ;;
            -h|--help|help)
                surface="help"
                shift
                ;;
            -*)
                fail "Unknown export option: $1"
                echo "Run 'harness export --help' for usage."
                exit 1
                ;;
            *)
                if [ -n "$target" ]; then
                    fail "Only one project directory can be provided."
                    exit 1
                fi
                target="$1"
                shift
                ;;
        esac
    done

    target="${target:-$(pwd)}"
    target="$(cd "$target" 2>/dev/null && pwd || pwd)"

    case "$surface" in
        codex)
            cat <<'EOF'
# Mick Agent Harness Loader — Codex Baseline

Use this when Codex is the code agent surface.

EOF
            print_project_manifest_state "$target"
            cat <<'EOF'

## Required Behavior

1. On opening a project, read the root `AGENTS.md` if present.
2. If `AGENTS.md` points to `.harness/rules/core.md` or `.harness/rules/extended.md`, treat those as the source of truth for Harness behavior.
3. Before editing files or generating deliverables, check whether `plan.md` exists and follow it only when it is active for this turn.
4. Do not force Planner/PM mode for ordinary discussion. Enter planning only when risk, ambiguity, user request, or an active plan requires it.
5. Finish delivery turns with what changed, how it was verified, and remaining risk.

EOF
            emit_common_contract
            echo ""
            echo "## Inline Core Rules"
            echo ""
            print_core_rules
            print_extended_policy "$include_extended"
            ;;
        agent)
            cat <<'EOF'
# Mick Agent Harness Loader — Generic Code Agent

Paste this into a code agent's global/user instructions once.

EOF
            print_project_manifest_state "$target"
            cat <<'EOF'

## Required Behavior

When I enter any code project:

1. Read the project-level Harness entry in this order:
   - `AGENTS.md`
   - `.harness/dist/AGENTS.md`
   - `.harness/rules/core.md`
2. If none exists, continue with the inline Core Rules below and tell the user the project is not initialized.
3. If a file edit or deliverable is requested, check root `plan.md` before editing. If it has active unchecked steps, act as Executor and stay inside the plan.
4. If the user is only discussing direction, requirements, architecture, or product thinking, do not mechanically force a plan. Keep the conversation natural and apply the Harness judgment rules.
5. End delivery/workflow turns with a concise round card or equivalent: what happened, verification, next step, and risk/blocker.

EOF
            emit_common_contract
            echo ""
            echo "## Inline Core Rules"
            echo ""
            print_core_rules
            print_extended_policy "$include_extended"
            ;;
        api)
            cat <<'EOF'
# Mick Agent Harness Loader — Pure API Prompt

Use this as a system/developer message for API calls that do not have a built-in code-agent environment.

EOF
            print_project_manifest_state "$target"
            cat <<'EOF'

## API Integration Contract

The caller must provide task input plus any available project context. If the API model cannot read local files itself, it must not claim that it checked files, tests, `plan.md`, git state, or runtime output.

The model must:

1. Treat this message as the active Harness unless a higher-priority system message conflicts.
2. Ask the caller to provide `AGENTS.md`, `plan.md`, relevant source files, logs, screenshots, or command output when those are required to make a grounded claim.
3. Distinguish facts from inference and unverified assumptions.
4. For code edits, return a patch or exact edit plan and name the verification evidence required.
5. If tool access is absent, say "unverified" for checks that require filesystem, tests, browser, network, or shell execution.
6. Never invent command output, file contents, test results, dates, package versions, API behavior, or user-visible screenshots.

EOF
            emit_common_contract
            echo ""
            echo "## Inline Core Rules"
            echo ""
            print_core_rules
            print_extended_policy "$include_extended"
            ;;
        ide)
            cat <<'EOF'
# Mick Agent Harness Loader — IDE Plugin

Paste this into an IDE AI plugin's custom instructions / rules field.

EOF
            print_project_manifest_state "$target"
            cat <<'EOF'

## IDE Plugin Contract

1. Prefer workspace files over memory. Read `AGENTS.md` or `.harness/dist/AGENTS.md` before making changes when the IDE exposes workspace context.
2. If the plugin can apply edits, read the target file first and preserve unrelated user changes.
3. If the plugin cannot run tests or inspect the app, label verification as pending and give the exact manual check or command.
4. If the plugin has partial context windows, prioritize Tripwire, current task files, `plan.md`, and the relevant section of `rules/core.md` over broad docs.
5. Do not let autocomplete-style suggestions bypass Harness: edits still need scope control, plan awareness, and verification.

EOF
            emit_common_contract
            echo ""
            echo "## Inline Core Rules"
            echo ""
            print_core_rules
            print_extended_policy "$include_extended"
            ;;
        all)
            local s
            for s in codex agent api ide; do
                echo ""
                echo "============================================================"
                echo "SURFACE: $s"
                echo "============================================================"
                if [ "$include_extended" = true ]; then
                    cmd_export "$s" "$target" --full
                else
                    cmd_export "$s" "$target"
                fi
            done
            ;;
        -h|--help|help)
            echo "Usage: harness export [codex|agent|api|ide|all] [project-dir] [--full]"
            echo ""
            echo "codex  Codex baseline loader"
            echo "agent  Generic code-agent global loader"
            echo "api    Pure API system/developer prompt"
            echo "ide    IDE plugin custom instruction loader"
            echo "all    Print every loader"
            echo ""
            echo "--full Inline rules/extended.md as well as rules/core.md"
            ;;
        *)
            fail "Unknown export surface: $surface"
            echo "Run 'harness export --help' for usage."
            exit 1
            ;;
    esac
}

# ============================================================
# harness agents — discover, diagnose and safely maintain Agent adapters
# ============================================================
cmd_agents() {
    local manager="$HARNESS_GLOBAL/scripts/harness-agent-manager.py"
    [ -f "$manager" ] || fail "scripts/harness-agent-manager.py not found."
    python3 "$manager" "$@"
}

# ============================================================
# harness brain — Brain workflow commands (status/install/sync/daily/evolve)
# ============================================================
cmd_brain() {
    local sub="${1:-status}"
    shift 2>/dev/null || true

    case "$sub" in
        status)
            echo ""
            echo -e "${BOLD}Brain Status${NC}"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            if [ -f "$HARNESS_GLOBAL/scripts/brain-resolve.sh" ]; then
                source "$HARNESS_GLOBAL/scripts/brain-resolve.sh"
                resolve_brain_dir "$HARNESS_GLOBAL" 2>/dev/null || true
                if [ -d "${BRAIN_DIR:-}" ]; then
                    if [ "${BRAIN_REMOTE_STATUS:-none}" = "connected" ]; then
                        echo -e "  Brain repo  : ${GREEN}connected${NC} ($BRAIN_DIR)"
                    elif [ -d "$BRAIN_DIR/.git" ]; then
                        echo -e "  Brain repo  : ${YELLOW}local fallback${NC} ($BRAIN_DIR)"
                    else
                        echo -e "  Brain repo  : ${YELLOW}directory only${NC} ($BRAIN_DIR)"
                    fi
                else
                    echo -e "  Brain repo  : ${YELLOW}not initialized — run 'harness brain install'${NC}"
                fi
            else
                echo -e "  Brain repo  : ${RED}resolver missing${NC}"
            fi
            if [ -f "$HARNESS_GLOBAL/scripts/hook-adapters.sh" ]; then
                source "$HARNESS_GLOBAL/scripts/hook-adapters.sh"
                hook_adapters_status
            fi
            # Check evolution data
            local trail="${BRAIN_DIR:-$HOME/.mick-brain}/global/evolution/audit-trail.md"
            if [ -f "$trail" ]; then
                local entries
                entries=$(grep -c "^## " "$trail" 2>/dev/null || true)
                entries="${entries:-0}"
                echo -e "  Audit data  : ${GREEN}$entries sessions${NC}"
            else
                echo -e "  Audit data  : ${YELLOW}empty — run 'harness-audit.sh --log' to start${NC}"
            fi
            echo ""
            ;;
        install)
            echo ""
            echo -e "${BOLD}Brain Install${NC}"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            if [ -f "$HARNESS_GLOBAL/scripts/hook-adapters.sh" ]; then
                source "$HARNESS_GLOBAL/scripts/hook-adapters.sh"
                hook_adapters_install
                echo -e "  ${GREEN}Brain directory and enabled hook adapters are ready.${NC}"
                hook_adapters_status
            else
                fail "hook-adapters.sh not found."
                exit 1
            fi
            echo ""
            ;;
        sync)
            echo -e "${BOLD}Brain Sync${NC} — running session distillation..."
            if [ -x "$HARNESS_GLOBAL/scripts/brain-sync.sh" ]; then
                "$HARNESS_GLOBAL/scripts/brain-sync.sh" "$@"
            else
                fail "brain-sync.sh not found."
                exit 1
            fi
            ;;
        daily)
            echo -e "${BOLD}Brain Daily${NC} — running batch distillation..."
            if [ -x "$HARNESS_GLOBAL/scripts/brain-sync-daily.sh" ]; then
                "$HARNESS_GLOBAL/scripts/brain-sync-daily.sh"
            else
                fail "brain-sync-daily.sh not found."
                exit 1
            fi
            ;;
        evolve)
            echo -e "${BOLD}Brain Evolve${NC} — generating rule proposals..."
            if [ -x "$HARNESS_GLOBAL/scripts/harness-evolve.sh" ]; then
                "$HARNESS_GLOBAL/scripts/harness-evolve.sh" "$@"
            else
                fail "harness-evolve.sh not found."
                exit 1
            fi
            ;;
        *)
            echo "Usage: harness brain [status|install|sync|daily|evolve]"
            echo ""
            echo "  status   Check hook/launchd/audit state"
            echo "  install  Set up SessionEnd hook + daily launchd sync"
            echo "  sync     Run session distillation manually"
            echo "  daily    Run batch daily sync manually"
            echo "  evolve   Generate rule evolution proposals"
            ;;
    esac
}

# ============================================================
# harness update — pull latest harness + regenerate
# ============================================================
cmd_update() {
    if [ ! -d "$HARNESS_GLOBAL/.git" ]; then
        fail "Harness not installed. Run: harness install"
        exit 1
    fi

    info "Updating harness..."
    stash_legacy_registry_if_dirty
    git -C "$HARNESS_GLOBAL" pull --rebase origin main
    chmod +x "$HARNESS_GLOBAL"/*.sh "$HARNESS_GLOBAL"/bin/* "$HARNESS_GLOBAL"/scripts/*.sh 2>/dev/null || true

    # Regenerate dist/
    if [ -x "$HARNESS_GLOBAL/generate.sh" ]; then
        "$HARNESS_GLOBAL/generate.sh" >/dev/null
    fi

    ok "Harness updated to $(git -C "$HARNESS_GLOBAL" rev-parse --short HEAD)."

    # Update all registered projects
    migrate_legacy_registry
    local reg="$HARNESS_REGISTRY"
    if [ -f "$reg" ]; then
        while IFS= read -r proj; do
            [ -z "$proj" ] && continue
            [ ! -d "$proj" ] && continue
            local link="$proj/.harness"
            info "Refreshing: $proj"
            if [ -f "$HARNESS_GLOBAL/scripts/lib-mount-rules.sh" ]; then
                source "$HARNESS_GLOBAL/scripts/lib-mount-rules.sh"
                mode="$(detect_project_rule_mode "$proj")"
                mount_rule_files "$HARNESS_GLOBAL" "$proj" "$mode" 2>/dev/null || true
            fi
        done < "$reg"
    fi

    cmd_agents sync --quiet
    install_observer_service

    ok "All registered projects refreshed."
}

# ============================================================
# harness check — run brain-check in current project
# ============================================================
cmd_check() {
    local target="${1:-$(pwd)}"
    if [ -x "$HARNESS_GLOBAL/scripts/brain-check.sh" ]; then
        "$HARNESS_GLOBAL/scripts/brain-check.sh" "$target"
    else
        fail "scripts/brain-check.sh not found."
        exit 1
    fi
}

# ============================================================
# harness report — summarize current project plan status
# ============================================================
cmd_structured_workflow() {
    local command="$1"
    shift
    local engine="$HARNESS_GLOBAL/scripts/harness-command.py"
    if [ ! -f "$engine" ]; then
        fail "Command engine not found: $engine"
        return 69
    fi
    python3 "$engine" "$command" "$@"
}

cmd_report() {
    local target="${1:-$(pwd)}"
    local plan="$target/plan.md"

    echo ""
    echo -e "${BOLD}📊 Harness Report${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    if [ ! -f "$plan" ]; then
        echo ""
        echo "  当前项目无 plan.md。"
        echo "  还没有进入 Plan-Execute 流程。"
        echo ""
        echo "  建议：用 Planner 角色为当前需求生成 plan.md。"
        echo ""
        return 0
    fi

    # Extract basic info
    local title status progress
    title=$(grep "^# Plan:" "$plan" 2>/dev/null | head -1 | sed 's/^# Plan: //')
    [ -z "$title" ] && title="未命名"
    status=$(grep "🧭 状态" "$plan" 2>/dev/null | head -1 | sed 's/.*🧭 状态：//' || echo "未知")
    total=$(grep -cE '^- \[[ x]\]' "$plan" 2>/dev/null || echo "0")
    total=$(echo "$total" | tr -d '[:space:]')
    completed=$(grep -cE '^- \[x\]' "$plan" 2>/dev/null || echo "0")
    completed=$(echo "$completed" | tr -d '[:space:]')
    progress="${completed}/${total}"

    echo ""
    echo "  Feature : ${title:-未命名}"
    echo "  Status  : ${status}"
    echo "  Progress: ${progress} steps"
    echo ""

    # Blocks
    local blocks
    blocks=$(sed -n '/^## 阻塞/,/^## /p' "$plan" | grep -c "^## 阻塞 #" 2>/dev/null || echo "0")
    if [ "${blocks:-0}" -gt 0 ]; then
        echo -e "  ${RED}Blocks  : $blocks${NC}"
        sed -n '/^## 阻塞/,/^## /p' "$plan" | grep "^## 阻塞 #" | while read -r line; do
            echo "    $line"
        done
    else
        echo -e "  ${GREEN}Blocks  : 0${NC}"
    fi
    echo ""

    # Self-check log
    local logs verify_ok verify_missing
    logs=$(grep -cE '^### Step' "$plan" 2>/dev/null || echo "0")
    verify_ok=$(grep -cE '^- verify:.*(passed|通过|PASS)' "$plan" 2>/dev/null || echo "0")
    verify_missing=$((logs - verify_ok))
    [ "$verify_missing" -lt 0 ] && verify_missing=0

    echo "  Self-check entries : $logs"
    echo "  Verified            : $verify_ok"
    [ "$verify_missing" -gt 0 ] && echo -e "  ${YELLOW}Unverified          : $verify_missing${NC}"

    # Last activity
    local last_step
    last_step=$(grep '^### Step' "$plan" 2>/dev/null | tail -1 | sed 's/### //')
    echo ""
    echo "  Last activity: ${last_step:-无}"
    echo ""

    # Suggestions
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if [ "${completed:-0}" -eq "${total:-0}" ] && [ "${total:-0}" -gt 0 ]; then
        echo "  → 所有步骤已完成。建议运行 Reviewer 审查。"
    elif [ "${blocks:-0}" -gt 0 ]; then
        echo "  → 有阻塞项。回到 Planner 裁决后继续。"
    elif [ "${completed:-0}" -lt "${total:-0}" ]; then
        echo "  → 继续执行剩余 $((total - completed)) 步。"
    else
        echo "  → plan.md 已创建但无步骤。用 Planner 补充步骤。"
    fi
    echo ""
}

# ============================================================
# harness metrics — aggregate task quality metrics
# ============================================================
cmd_metrics() {
    set +e  # grep -c returns 1 on zero matches, don't abort
    local target="${1:-$(pwd)}"
    local plan="$target/plan.md"
    local audit_log=""
    for f in "$HARNESS_GLOBAL/audit-log.md" "$HARNESS_GLOBAL/scripts/../audit-log.md" "$HOME/.mick-brain/global/evolution/audit-trail.md"; do
        [ -f "$f" ] && audit_log="$f" && break
    done

    echo ""
    echo -e "${BOLD}📈 Harness Metrics${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # === Plan-based metrics ===
    if [ -f "$plan" ]; then
        total=$(grep -cE '^- \[[ x]\]' "$plan" 2>/dev/null); total=${total:-0}
        completed=$(grep -cE '^- \[x\]' "$plan" 2>/dev/null); completed=${completed:-0}
        verify_ok=$(grep -cE '^- verify:.*(passed|通过|PASS)' "$plan" 2>/dev/null); verify_ok=${verify_ok:-0}
        verify_failed=$(grep -cE '^- verify:.*(failed|失败|FAIL)' "$plan" 2>/dev/null); verify_failed=${verify_failed:-0}
        log_count=$(grep -cE '^### Step' "$plan" 2>/dev/null); log_count=${log_count:-0}
        deviations=$(grep -cE '偏离|deviation|diverged' "$plan" 2>/dev/null); deviations=${deviations:-0}
        verify_missing=$(( ${log_count:-0} - ${verify_ok:-0} - ${verify_failed:-0} ))
        [ "${verify_missing:-0}" -lt 0 ] && verify_missing=0

        echo ""
        echo "  ── Plan Execution ──"
        printf "  %-28s %s\n" "Task completion rate" "${completed}/${total}"
        printf "  %-28s %s\n" "Verification coverage" "${verify_ok}/${log_count} verified"
        printf "  %-28s %s\n" "Verification missing" "$verify_missing"
        printf "  %-28s %s\n" "Plan deviations" "$deviations"
        printf "  %-28s %s\n" "Active blocks" "${blocks:-0}"
    else
        echo ""
        echo "  (无 plan.md — Plan-Execute 指标不可用)"
    fi

    # === Audit-based metrics ===
    if [ -n "$audit_log" ] && [ -f "$audit_log" ]; then
        local scope_creep verify_fail repeated
        scope_creep=$(grep -c "scope-creep" "$audit_log" 2>/dev/null || echo "0")
        verify_fail=$(grep -c "verify-missing\|verify-vague\|verify-unverified\|verify-failed" "$audit_log" 2>/dev/null || echo "0")
        repeated=$(grep -c "repeated\|撞墙" "$audit_log" 2>/dev/null || echo "0")

        echo ""
        echo "  ── Historical Signals ──"
        printf "  %-28s %s\n" "Scope creep events" "$scope_creep"
        printf "  %-28s %s\n" "Verification failures" "$verify_fail"
        printf "  %-28s %s\n" "Repeated failure signals" "$repeated"
    else
        echo ""
        echo "  ── Historical Signals ──"
        echo "  (无 audit-log — 运行 harness-audit.sh --log 开始累积)"
    fi

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  → 运行 'harness report' 查看当前任务详情。"
    echo ""
    set -e
}

# ============================================================
# harness observe — local Harness work server and portfolio
# ============================================================
cmd_observe() {
    if ! command -v python3 >/dev/null 2>&1; then
        fail "harness observe requires Python 3."
        return 1
    fi

    local observe_script="$HARNESS_GLOBAL/scripts/harness-observe.py"
    if [ ! -f "$observe_script" ]; then
        fail "Observe runtime not found: $observe_script"
        return 1
    fi

    python3 "$observe_script" "$@"
}

# ============================================================
# Harness CLI activity — best-effort, argument-free lifecycle
# ============================================================
HARNESS_ACTIVITY_COMMAND=""
HARNESS_ACTIVITY_PROJECT=""
HARNESS_ACTIVITY_INVOCATION=""

record_harness_activity() {
    local state="$1"
    local exit_code="${2:-}"
    [ "${MICK_HARNESS_ACTIVITY:-1}" != "0" ] || return 0
    [ -n "$HARNESS_ACTIVITY_COMMAND" ] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    local observe_script="$HARNESS_GLOBAL/scripts/harness-observe.py"
    [ -f "$observe_script" ] || return 0
    local args=(
        activity
        --project "$HARNESS_ACTIVITY_PROJECT"
        --command "$HARNESS_ACTIVITY_COMMAND"
        --state "$state"
        --invocation "$HARNESS_ACTIVITY_INVOCATION"
    )
    if [ -n "$exit_code" ]; then
        args+=(--exit-code "$exit_code")
    fi
    python3 "$observe_script" "${args[@]}" >/dev/null 2>&1 || true
}

start_harness_activity() {
    HARNESS_ACTIVITY_COMMAND="${1:-help}"
    HARNESS_ACTIVITY_PROJECT="$(pwd -P)"
    HARNESS_ACTIVITY_INVOCATION="cli-$(date -u +%Y%m%d%H%M%S)-$$"
    record_harness_activity started
}

finish_harness_activity() {
    local exit_code=$?
    trap - EXIT
    record_harness_activity completed "$exit_code"
    exit "$exit_code"
}

# ============================================================
# Main
# ============================================================
start_harness_activity "${1:-help}"
trap finish_harness_activity EXIT

case "${1:-}" in
    init)
        shift
        cmd_init "$@"
        ;;
    install)
        cmd_install
        ;;
    update)
        cmd_update
        ;;
    export|loader|load)
        shift
        cmd_export "$@"
        ;;
    check)
        shift
        cmd_check "${1:-}"
        ;;
    plan)
        shift
        cmd_structured_workflow plan "$@"
        ;;
    goal)
        shift
        cmd_structured_workflow goal "$@"
        ;;
    brain)
        shift
        cmd_brain "$@"
        ;;
    agents)
        shift
        cmd_agents "$@"
        ;;
    report)
        shift
        cmd_report "${1:-}"
        ;;
    metrics)
        shift
        cmd_metrics "${1:-}"
        ;;
    observe)
        shift
        cmd_observe "$@"
        ;;
    version|--version|-v)
        cmd_version
        ;;
    help|--help|-h|"")
        echo "Mick Agent Harness — 个人 Agent 协作层 CLI"
        echo ""
        echo "用法:"
        echo "  harness install          一次性全局安装"
        echo "  harness init [dir]       在当前（或指定）目录初始化 Harness（默认 AGENTS.md）"
        echo "  harness init --full      额外启用 config / Brain 检查"
        echo "  harness init --all-rules 额外挂旧工具入口"
        echo "  harness export [surface] 输出 Codex / Agent / API / IDE 加载器"
        echo "  harness agents [scan|doctor|sync|migrate|hooks] 管理本机 Code Agent 接入"
        echo "  harness update           更新全局 Harness + 刷新所有注册项目"
        echo "  harness check [dir]      验证当前项目脚手架完整性"
        echo "  harness plan [options]   扫描项目并预览/建立 plan.md（默认只预览）"
        echo "  harness goal [options]   查看/维护长期项目目标（默认只预览）"
        echo "  harness report [dir]     查看当前任务计划与执行状态"
        echo "  harness metrics [dir]    聚合任务质量指标"
        echo "  harness observe [cmd]    汇总项目进度并向本地工作服务器回写 Agent 事件"
        echo "  harness brain [cmd]      Brain 状态/安装/同步/蒸馏/进化"
        echo "  harness version          查看版本"
        echo ""
        echo "安装后进入任意项目目录，一行命令搞定："
        echo "  harness init"
        echo ""
        echo "给不同 AI 入口注入 Harness："
        echo "  harness agents doctor    查看发现、注入、Hook 与待验证状态"
        echo "  harness agents sync      原子同步 Claude/Codex 全局 Loader"
        echo "  harness agents migrate   迁移旧受管区块（先加 --dry-run）"
        echo "  harness agents hooks     安装生命周期回写（先加 --dry-run）"
        echo "  harness export codex     手动导出 Codex loader"
        echo "  harness export agent     手动导出通用 Agent loader"
        echo "  harness export api       手动导出 API prompt"
        echo "  harness export ide       手动导出 IDE plugin loader"
        ;;
    *)
        fail "Unknown command: $1"
        echo "Run 'harness help' for usage."
        exit 1
        ;;
esac
