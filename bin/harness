#!/bin/bash
set -euo pipefail

# ============================================================
# harness — Mick Harness 全局 CLI
#
# 一次全局安装，任何项目中一键初始化。
#
# 安装：
#   git clone https://github.com/MickMi/mick_harness_rules.git ~/.mick-harness
#   ln -s ~/.mick-harness/bin/harness ~/.local/bin/harness
#
# 使用：
#   harness init              # 当前目录初始化
#   harness init /path/to/proj # 指定目录初始化
#   harness update             # 更新全局 harness + 注册项目
#   harness check              # 验证当前项目完整性
#   harness version            # 查看版本
# ============================================================

HARNESS_GLOBAL="${MICK_HARNESS_ROOT:-$HOME/.mick-harness}"
HARNESS_REPO="https://github.com/MickMi/mick_harness_rules.git"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'
info()  { echo -e "${CYAN}ℹ️  $1${NC}"; }
ok()    { echo -e "${GREEN}✅ $1${NC}"; }
warn()  { echo -e "${YELLOW}⚠️  $1${NC}"; }
fail()  { echo -e "${RED}❌ $1${NC}"; }

# ============================================================
# harness version
# ============================================================
cmd_version() {
    if [ -d "$HARNESS_GLOBAL/.git" ]; then
        local ver
        ver=$(git -C "$HARNESS_GLOBAL" describe --tags --always 2>/dev/null || echo "unknown")
        echo "Mick Harness $ver  ($HARNESS_GLOBAL)"
    else
        echo "Mick Harness (not installed. Run: harness install)"
    fi
}

# ============================================================
# harness install — clone global harness repo once
# ============================================================
cmd_install() {
    if [ -d "$HARNESS_GLOBAL/.git" ]; then
        ok "Harness already installed at $HARNESS_GLOBAL"
        info "Run 'harness update' to pull latest."
        return 0
    fi

    info "Installing Mick Harness to $HARNESS_GLOBAL ..."
    git clone "$HARNESS_REPO" "$HARNESS_GLOBAL"
    chmod +x "$HARNESS_GLOBAL"/*.sh "$HARNESS_GLOBAL"/bin/* 2>/dev/null || true

    # Add to PATH hint
    local bin_dir="$HARNESS_GLOBAL/bin"
    if [ -d "$HOME/.local/bin" ] && [ ! -L "$HOME/.local/bin/harness" ]; then
        ln -s "$bin_dir/harness" "$HOME/.local/bin/harness" 2>/dev/null || true
    fi

    echo ""
    ok "Harness installed."
    echo ""
    echo "  确保 ~/.local/bin 在 PATH 中（大多数 macOS 已默认包含）："
    echo "    export PATH=\"\$HOME/.local/bin:\$PATH\""
    echo ""
    echo "  然后进入任意项目目录："
    echo "    harness init"
}

# ============================================================
# harness init [project-dir] — one-command project bootstrap
# ============================================================
cmd_init() {
    # Ensure harness is installed globally
    if [ ! -d "$HARNESS_GLOBAL/.git" ]; then
        info "Harness not yet installed. Installing first..."
        cmd_install || { fail "Install failed."; exit 1; }
        echo ""
    fi

    local target="${1:-$(pwd)}"
    target="$(cd "$target" 2>/dev/null && pwd || echo "")"
    if [ -z "$target" ] || [ ! -d "$target" ]; then
        fail "Target directory does not exist: ${1:-current dir}"
        exit 1
    fi

    echo -e "${BOLD}🚀 harness init${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  Target: $target"
    echo "  Source: $HARNESS_GLOBAL"
    echo ""

    # --- 1. Symlink .harness/ into project ---
    local harness_link="$target/.harness"
    if [ -L "$harness_link" ]; then
        ok ".harness/ symlink already exists. (idempotent)"
    elif [ -d "$harness_link" ]; then
        warn ".harness/ already exists as a real directory. Skipping symlink."
    else
        ln -s "$HARNESS_GLOBAL" "$harness_link"
        ok ".harness/ → $HARNESS_GLOBAL"
    fi

    # --- 2. Run generate.sh ---
    if [ -x "$HARNESS_GLOBAL/generate.sh" ]; then
        info "Generating rule files..."
        "$HARNESS_GLOBAL/generate.sh" >/dev/null
        ok "7 IDE rule files generated."
    fi

    # --- 3. Mount rule files into project ---
    if [ -f "$HARNESS_GLOBAL/scripts/lib-mount-rules.sh" ]; then
        source "$HARNESS_GLOBAL/scripts/lib-mount-rules.sh"
        mount_rule_files "$HARNESS_GLOBAL" "$target" 2>/dev/null || true
        ok "Rules mounted to project root."
    fi

    # --- 4. .gitignore ---
    local gitignore="$target/.gitignore"
    local entries=(".harness/" ".harness" ".prompts/" ".prompts")
    entries+=("${HARNESS_OWNED_FILES[@]}")
    if [ ! -f "$gitignore" ]; then
        touch "$gitignore"
    fi
    for entry in "${entries[@]}"; do
        if ! grep -qxF "$entry" "$gitignore" 2>/dev/null; then
            echo "$entry" >> "$gitignore"
        fi
    done
    ok ".gitignore updated."

    # --- 5. Config ---
    local config="$target/.harness-config.yaml"
    if [ ! -f "$config" ]; then
        if [ -f "$HARNESS_GLOBAL/config/.harness-config.template.yaml" ]; then
            cp "$HARNESS_GLOBAL/config/.harness-config.template.yaml" "$config"
            ok ".harness-config.yaml created. Edit it to set your preferences."
        fi
    else
        ok ".harness-config.yaml already exists. (idempotent)"
    fi

    # --- 6. Scaffold files (skip if exist) ---
    mkdir -p "$target/docs"
    if [ ! -f "$target/MEMORY.md" ] && [ ! -L "$target/MEMORY.md" ]; then
        cat > "$target/MEMORY.md" << 'EOF'
# 项目记忆与经验库 (Memory & Learnings)

## 🏗️ 架构决策记录 (ADR)
*在这里记录我们在对话中决定引入的新库、核心数据结构变更或重大架构妥协。*

## ⚠️ 已知天坑与环境限制 (Gotchas)
- (暂无)

## 💡 设计原则备忘
*从历史讨论中提炼的核心设计原则。*
EOF
        ok "MEMORY.md created."
    fi
    if [ ! -f "$target/TODO.md" ] && [ ! -L "$target/TODO.md" ]; then
        cat > "$target/TODO.md" << 'EOF'
# 项目待办与状态流转

## 🚧 当前进行中 (In Progress)
- [ ]

## 📋 待办清单 (Backlog)
- [ ] 编写核心业务逻辑

## ✅ 已完成 (Done)
- [x] Harness 脚手架初始化
EOF
        ok "TODO.md created."
    fi

    # --- 7. Brain repo — connect if configured ---
    if [ -f "$HARNESS_GLOBAL/scripts/brain-resolve.sh" ]; then
        source "$HARNESS_GLOBAL/scripts/brain-resolve.sh"
        resolve_brain_dir "$HARNESS_GLOBAL" 2>/dev/null || true
        if [ -n "${BRAIN_REPO_REMOTE:-}" ]; then
            local brain_local="${BRAIN_REPO_LOCAL:-$HOME/.mick-brain}"
            if [ -d "$brain_local/.git" ]; then
                ok "Brain repo already connected: $brain_local"
            else
                info "Cloning brain repo..."
                if git clone --quiet "$BRAIN_REPO_REMOTE" "$brain_local" 2>/dev/null; then
                    ok "Brain repo connected: $brain_local"
                else
                    warn "Brain repo unavailable (OK for fork users). Local fallback will be used."
                fi
            fi
            # Symlink brain/ in harness
            local brain_link="$HARNESS_GLOBAL/brain"
            if [ ! -L "$brain_link" ] && [ ! -d "$brain_link" ]; then
                ln -s "$brain_local" "$brain_link" 2>/dev/null || true
            fi
        fi
    fi

    # --- 8. Verify — run brain-check ---
    echo ""
    if [ -x "$HARNESS_GLOBAL/scripts/brain-check.sh" ]; then
        "$HARNESS_GLOBAL/scripts/brain-check.sh" "$target" 2>&1 || true
    fi

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e "${GREEN}${BOLD}✅ Done.${NC} Harness is active."
    echo ""
    echo "  当前项目的 AI 助手已经受 Harness 约束。"
    echo "  打开任意 AI 工具验证：让它做一次 Harness Self-Test。"
    echo ""
}

# ============================================================
# harness update — pull latest harness + regenerate
# ============================================================
cmd_update() {
    if [ ! -d "$HARNESS_GLOBAL/.git" ]; then
        fail "Harness not installed. Run: harness install"
        exit 1
    fi

    info "Updating harness..."
    git -C "$HARNESS_GLOBAL" pull --rebase origin main
    chmod +x "$HARNESS_GLOBAL"/*.sh "$HARNESS_GLOBAL"/bin/* 2>/dev/null || true

    # Regenerate dist/
    if [ -x "$HARNESS_GLOBAL/generate.sh" ]; then
        "$HARNESS_GLOBAL/generate.sh" >/dev/null
    fi

    ok "Harness updated to $(git -C "$HARNESS_GLOBAL" rev-parse --short HEAD)."

    # Update all registered projects
    local reg="$HARNESS_GLOBAL/.registered-projects"
    if [ -f "$reg" ]; then
        while IFS= read -r proj; do
            [ -z "$proj" ] && continue
            [ ! -d "$proj" ] && continue
            local link="$proj/.harness"
            info "Refreshing: $proj"
            if [ -f "$HARNESS_GLOBAL/scripts/lib-mount-rules.sh" ]; then
                source "$HARNESS_GLOBAL/scripts/lib-mount-rules.sh"
                mount_rule_files "$HARNESS_GLOBAL" "$proj" 2>/dev/null || true
            fi
        done < "$reg"
    fi

    ok "All registered projects refreshed."
}

# ============================================================
# harness check — run brain-check in current project
# ============================================================
cmd_check() {
    local target="${1:-$(pwd)}"
    if [ -x "$HARNESS_GLOBAL/scripts/brain-check.sh" ]; then
        "$HARNESS_GLOBAL/scripts/brain-check.sh" "$target"
    else
        fail "scripts/brain-check.sh not found."
        exit 1
    fi
}

# ============================================================
# harness report — summarize current project plan status
# ============================================================
cmd_report() {
    local target="${1:-$(pwd)}"
    local plan="$target/plan.md"

    echo ""
    echo -e "${BOLD}📊 Harness Report${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    if [ ! -f "$plan" ]; then
        echo ""
        echo "  当前项目无 plan.md。"
        echo "  还没有进入 Plan-Execute 流程。"
        echo ""
        echo "  建议：用 Planner 角色为当前需求生成 plan.md。"
        echo ""
        return 0
    fi

    # Extract basic info
    local title status progress
    title=$(grep "^# Plan:" "$plan" 2>/dev/null | head -1 | sed 's/^# Plan: //')
    [ -z "$title" ] && title="未命名"
    status=$(grep "🧭 状态" "$plan" 2>/dev/null | head -1 | sed 's/.*🧭 状态：//' || echo "未知")
    total=$(grep -cE '^- \[[ x]\]' "$plan" 2>/dev/null || echo "0")
    total=$(echo "$total" | tr -d '[:space:]')
    completed=$(grep -cE '^- \[x\]' "$plan" 2>/dev/null || echo "0")
    completed=$(echo "$completed" | tr -d '[:space:]')
    progress="${completed}/${total}"

    echo ""
    echo "  Feature : ${title:-未命名}"
    echo "  Status  : ${status}"
    echo "  Progress: ${progress} steps"
    echo ""

    # Blocks
    local blocks
    blocks=$(sed -n '/^## 阻塞/,/^## /p' "$plan" | grep -c "^## 阻塞 #" 2>/dev/null || echo "0")
    if [ "${blocks:-0}" -gt 0 ]; then
        echo -e "  ${RED}Blocks  : $blocks${NC}"
        sed -n '/^## 阻塞/,/^## /p' "$plan" | grep "^## 阻塞 #" | while read -r line; do
            echo "    $line"
        done
    else
        echo -e "  ${GREEN}Blocks  : 0${NC}"
    fi
    echo ""

    # Self-check log
    local logs verify_ok verify_missing
    logs=$(grep -cE '^### Step' "$plan" 2>/dev/null || echo "0")
    verify_ok=$(grep -cE '^- verify:.*(passed|通过|PASS)' "$plan" 2>/dev/null || echo "0")
    verify_missing=$((logs - verify_ok))
    [ "$verify_missing" -lt 0 ] && verify_missing=0

    echo "  Self-check entries : $logs"
    echo "  Verified            : $verify_ok"
    [ "$verify_missing" -gt 0 ] && echo -e "  ${YELLOW}Unverified          : $verify_missing${NC}"

    # Last activity
    local last_step
    last_step=$(grep '^### Step' "$plan" 2>/dev/null | tail -1 | sed 's/### //')
    echo ""
    echo "  Last activity: ${last_step:-无}"
    echo ""

    # Suggestions
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if [ "${completed:-0}" -eq "${total:-0}" ] && [ "${total:-0}" -gt 0 ]; then
        echo "  → 所有步骤已完成。建议运行 Reviewer 审查。"
    elif [ "${blocks:-0}" -gt 0 ]; then
        echo "  → 有阻塞项。回到 Planner 裁决后继续。"
    elif [ "${completed:-0}" -lt "${total:-0}" ]; then
        echo "  → 继续执行剩余 $((total - completed)) 步。"
    else
        echo "  → plan.md 已创建但无步骤。用 Planner 补充步骤。"
    fi
    echo ""
}

# ============================================================
# harness metrics — aggregate task quality metrics
# ============================================================
cmd_metrics() {
    set +e  # grep -c returns 1 on zero matches, don't abort
    local target="${1:-$(pwd)}"
    local plan="$target/plan.md"
    local audit_log=""
    for f in "$HARNESS_GLOBAL/audit-log.md" "$HARNESS_GLOBAL/scripts/../audit-log.md" "$HOME/.mick-brain/global/evolution/audit-trail.md"; do
        [ -f "$f" ] && audit_log="$f" && break
    done

    echo ""
    echo -e "${BOLD}📈 Harness Metrics${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # === Plan-based metrics ===
    if [ -f "$plan" ]; then
        total=$(grep -cE '^- \[[ x]\]' "$plan" 2>/dev/null); total=${total:-0}
        completed=$(grep -cE '^- \[x\]' "$plan" 2>/dev/null); completed=${completed:-0}
        verify_ok=$(grep -cE '^- verify:.*(passed|通过|PASS)' "$plan" 2>/dev/null); verify_ok=${verify_ok:-0}
        verify_failed=$(grep -cE '^- verify:.*(failed|失败|FAIL)' "$plan" 2>/dev/null); verify_failed=${verify_failed:-0}
        log_count=$(grep -cE '^### Step' "$plan" 2>/dev/null); log_count=${log_count:-0}
        deviations=$(grep -cE '偏离|deviation|diverged' "$plan" 2>/dev/null); deviations=${deviations:-0}
        verify_missing=$(( ${log_count:-0} - ${verify_ok:-0} - ${verify_failed:-0} ))
        [ "${verify_missing:-0}" -lt 0 ] && verify_missing=0

        echo ""
        echo "  ── Plan Execution ──"
        printf "  %-28s %s\n" "Task completion rate" "${completed}/${total}"
        printf "  %-28s %s\n" "Verification coverage" "${verify_ok}/${log_count} verified"
        printf "  %-28s %s\n" "Verification missing" "$verify_missing"
        printf "  %-28s %s\n" "Plan deviations" "$deviations"
        printf "  %-28s %s\n" "Active blocks" "${blocks:-0}"
    else
        echo ""
        echo "  (无 plan.md — Plan-Execute 指标不可用)"
    fi

    # === Audit-based metrics ===
    if [ -n "$audit_log" ] && [ -f "$audit_log" ]; then
        local scope_creep verify_fail repeated
        scope_creep=$(grep -c "scope-creep" "$audit_log" 2>/dev/null || echo "0")
        verify_fail=$(grep -c "verify-missing\|verify-vague\|verify-unverified\|verify-failed" "$audit_log" 2>/dev/null || echo "0")
        repeated=$(grep -c "repeated\|撞墙" "$audit_log" 2>/dev/null || echo "0")

        echo ""
        echo "  ── Historical Signals ──"
        printf "  %-28s %s\n" "Scope creep events" "$scope_creep"
        printf "  %-28s %s\n" "Verification failures" "$verify_fail"
        printf "  %-28s %s\n" "Repeated failure signals" "$repeated"
    else
        echo ""
        echo "  ── Historical Signals ──"
        echo "  (无 audit-log — 运行 harness-audit.sh --log 开始累积)"
    fi

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  → 运行 'harness report' 查看当前任务详情。"
    echo ""
    set -e
}

# ============================================================
# Main
# ============================================================
case "${1:-}" in
    init)
        shift
        cmd_init "${1:-}"
        # Register this project for future updates
        _target="$(cd "${1:-$(pwd)}" 2>/dev/null && pwd || pwd)"
        _reg="$HARNESS_GLOBAL/.registered-projects"
        if ! grep -qxF "$_target" "$_reg" 2>/dev/null; then
            echo "$_target" >> "$_reg"
        fi
        ;;
    install)
        cmd_install
        ;;
    update)
        cmd_update
        ;;
    check)
        shift
        cmd_check "${1:-}"
        ;;
    report)
        shift
        cmd_report "${1:-}"
        ;;
    metrics)
        shift
        cmd_metrics "${1:-}"
        ;;
    version|--version|-v)
        cmd_version
        ;;
    help|--help|-h|"")
        echo "Mick Harness — 全局工程护栏 CLI"
        echo ""
        echo "用法:"
        echo "  harness install          一次性全局安装"
        echo "  harness init [dir]       在当前（或指定）目录初始化 Harness"
        echo "  harness update           更新全局 Harness + 刷新所有注册项目"
        echo "  harness check [dir]      验证当前项目脚手架完整性"
        echo "  harness report [dir]     查看当前任务计划与执行状态"
        echo "  harness metrics [dir]    聚合任务质量指标"
        echo "  harness version          查看版本"
        echo ""
        echo "安装后进入任意项目目录，一行命令搞定："
        echo "  harness init"
        ;;
    *)
        fail "Unknown command: $1"
        echo "Run 'harness help' for usage."
        exit 1
        ;;
esac
