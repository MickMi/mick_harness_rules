{
  "schema_version": "1",
  "agents": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "tier": 1,
      "detection": {
        "commands": ["claude"],
        "config_dirs": [".claude"],
        "apps": ["Claude.app"],
        "extensions": ["anthropic.claude-code", "anthropic.claude"]
