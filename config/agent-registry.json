      "loader": {"surface": "agent", "target": ".claude/CLAUDE.md", "managed": true},
      "lifecycle": {"adapter": "claude-hooks", "events": ["SessionStart", "UserPromptSubmit", "Stop", "SessionEnd"]},
      "limitations": []
    },
