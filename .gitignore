# Brain data (lives in separate private repo, linked via symlink)
# The brain/ symlink points to ~/.brain/ (private local or Git repo)
brain

# Brain migration backup (one-time, safe to delete after migration)
brain.bak/

# Brain owner identity (personal)
.brain-owner

# Generated rule files — always rebuilt from rules/core.md + extended.md by
# generate.sh (run automatically in setup.sh / brain-init.sh before mounting).
dist/

# OS files
.DS_Store
__pycache__/
*.py[cod]
audit-log.md
.registered-projects
.harness/
.harness
.cursorrules
.prompts/
.prompts
AGENTS.md
# Observer runtime data (per-project append-only ledger, never tracked)
.harness-runtime/
